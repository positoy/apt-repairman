# Browser-safe Naver Maps JavaScript API key ID.
# This is used as ncpKeyId in https://oapi.map.naver.com/openapi/v3/maps.js?ncpKeyId=...
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Server-only Naver Maps/API Gateway credentials.
# Do not prefix the secret value with NEXT_PUBLIC_*.
NAVER_CLOUD_MAPS_API_KEY_ID=
NAVER_CLOUD_MAPS_API_KEY=

# Server-only Naver Cloud Platform IAM credentials for HMAC signature APIs.
# Use these only for APIs that require x-ncp-apigw-signature-v2.
NAVER_CLOUD_ACCESS_KEY_ID=
NAVER_CLOUD_SECRET_KEY=
